{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["chrome-devtools"],
  "permissions": {
    "allow": [
      "Bash(node setup/doctor.mjs:*)",
      "Bash(node setup/snap.mjs:*)",
      "Bash(node setup/launch.mjs:*)",
      "Bash(npm run doctor:*)",
      "Bash(npm run labs:install)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(pico-cli --version)",
      "Bash(pico-cli emulator status:*)",
      "Bash(pico-cli emulator list:*)",
      "Bash(pico-cli emulator doctor:*)",
      "Bash(pico-cli emulator start:*)",
      "Bash(pico-cli emulator stop:*)",
      "Bash(pico-cli device list:*)",
      "Bash(pico-cli device info:*)",
      "Bash(pico-cli log:*)",
      "Bash(pico-cli capture screenshot:*)",
      "Bash(pico-cli capture record:*)",
      "Bash(pico-cli knowledge doctor:*)",
      "Bash(pico-cli plugin doctor:*)"
    ],
    "ask": [
      "Bash(pico-cli setup:*)",
      "Bash(pico-cli doctor --fix:*)",
      "Bash(pico-cli web launch:*)",
      "Bash(pico-cli app install:*)",
      "Bash(pico-cli emulator start --wipe-data:*)",
      "Bash(pico-cli emulator delete:*)",
      "Bash(pico-cli emulator delete-image:*)",
      "Bash(pico-cli emulator install:*)",
      "Bash(pico-cli emulator setup:*)",
      "Bash(pico-cli update:*)",
      "Bash(npm install -g:*)",
      "Bash(winget install:*)",
      "Bash(brew install:*)"
    ]
  }
}
